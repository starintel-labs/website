{
  "name": "@starintel/main",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "starintel.actor - StarIntel main website, radar, and public-safe API surfaces",
  "scripts": {
    "dev": "vite",
    "build": "node --experimental-strip-types scripts/build-research.ts && vite build",
