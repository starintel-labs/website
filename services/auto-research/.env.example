# HTTP API auth. Required; protected endpoints fail closed without it.
AUTO_RESEARCH_API_TOKEN=change-me

# Forgejo API used to seed one issue per requested project.
FORGEJO_BASE_URL=https://forgejo.example
FORGEJO_TOKEN=change-me

# Prolog-RLM checkout and direct-mode model.
PROLOG_RLM_ROOT=/srv/prolog-rlm
AUTO_RESEARCH_MODEL=z-ai/your-glm-model
OPENROUTER_API_KEY=change-me

# Local runtime state.
AUTO_RESEARCH_RUN_ROOT=/var/lib/starintel/auto-research
AUTO_RESEARCH_HOST=127.0.0.1
AUTO_RESEARCH_PORT=8097
AUTO_RESEARCH_RUNNER_ENABLED=true
